# Compiled binaries (root-level only — not cmd/memoria/ directory)
/memoria
memoria-*
*.test
*.out
*.exe

# Go build cache / module cache shouldn't leak
/dist/
/build/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local-only secrets — should never end up here, defense in depth
.env
.env.*
!.env.example
*.pem
*.key
